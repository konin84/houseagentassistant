# ============================================================================
#  Production environment - copy to .env.prod on the VPS and fill in.
# ============================================================================
#      docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
#  .env.prod is gitignored. It should be readable only by the deploy user:
#      chmod 600 .env.prod
#
#  None of the services carry fallbacks under the prod profile. A variable left
#  blank here stops the boot naming the property it wanted, which is the point -
#  a service that starts quietly connected as postgres/postgres, trusting no
#  identity provider, is worse than one that does not start.
#
#  See docs/deployment.md.
# ============================================================================

# --- Image tag ---------------------------------------------------------------
# Deploy a tag you can name, not "latest". Rolling back means knowing what the
# previous one was.
TAG=1.0.0

# --- Database ----------------------------------------------------------------
# One database per service; the URLs are fixed in docker-compose.prod.yml, since
# they point at a container on the internal network. Only the credentials vary.
#
# The lease database needs btree_gist for the exclusion constraint that stops a
# house being let twice. The migration issues CREATE EXTENSION, so this role
# must be able to - true for the container below, often not true on a managed
# PostgreSQL, where you create the extension by hand first.
DB_USERNAME=houseagent
DB_PASSWORD=

# --- Identity ----------------------------------------------------------------
# The public URL clients actually fetch tokens from, and the single most common
# way this deployment breaks. A token's iss claim is built from the host it was
# requested through; if this does not match byte for byte - scheme, host,
# trailing slash - all five services reject tokens that are perfectly valid.
OIDC_AUTH_SERVER_URL=https://auth.example.com/realms/houseagent
OIDC_CLIENT_ID=houseagent-backend
# Generate a new one in the production realm. The development value is published
# in this repository.
OIDC_CLIENT_SECRET=

# --- Keycloak ----------------------------------------------------------------
# The hostname Keycloak believes it has. Must agree with OIDC_AUTH_SERVER_URL
# and with the Host() rule in infra/traefik/prod/dynamic.yaml.
KEYCLOAK_HOSTNAME=https://auth.example.com
KEYCLOAK_REALM=houseagent

# Reached by agency-service over the internal network, so this is the container
# address rather than the public one - no TLS handshake and no round trip out to
# the internet for a call that never leaves the box.
KEYCLOAK_URL=http://keycloak:8080

# The credential that creates user accounts. Scope its service account to
# manage-users, view-users and query-users and nothing further: losing it should
# not be able to grant anybody a privilege the platform does not already hand
# out through signup.
KEYCLOAK_ADMIN_CLIENT_ID=houseagent-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=

# Bootstrap admin, used once to create the realm and a real administrator.
# Remove both lines and restart Keycloak afterwards - a permanent bootstrap
# credential is a permanent way in.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=

# --- Mail --------------------------------------------------------------------
# Real people are emailed from here. In development Mailpit catches everything;
# there is no such safety net now. start-tls and login are REQUIRED in
# application-prod.yaml, so the provider must support both.
MAIL_FROM=no-reply@example.com
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Cloudinary --------------------------------------------------------------
# Use a different account or folder from development. House images are real
# external state: the bytes never pass through the service, so anything uploaded
# while testing is in whatever account these keys name.
#
# The API secret signs upload requests. It never leaves the server and never
# appears in a response - only the derived signature does.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Gateway -----------------------------------------------------------------
# Where Let's Encrypt sends expiry warnings. The hostnames themselves live in
# infra/traefik/prod/dynamic.yaml - Traefik's file provider does no variable
# substitution, so they cannot be set from here.
ACME_EMAIL=

# --- Logging -----------------------------------------------------------------
APP_LOG_LEVEL=INFO
