# Copy this file to .env and fill in real values. .env is gitignored.
#
# Quarkus dev mode picks .env up automatically from the module working directory,
# so run services from their own folder (e.g. cd property-service && ../mvnw quarkus:dev).

# --- Local PostgreSQL (the postgresql-x64-18 Windows service on port 5432) ---
DB_USERNAME=postgres
DB_PASSWORD=change-me

# --- Event backbone (Redpanda in docker-compose). Not needed to run the tests: ---
# --- both services swap in an in-memory connector under the test profile.      ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Outbound mail. Mailpit in docker-compose catches everything at :8025, so ---
# --- landlord notifications can be read without emailing a real person.       ---
MAIL_FROM=no-reply@houseagent.local
MAIL_HOST=localhost
MAIL_PORT=1025

# --- Cloudinary, which hosts house images -----------------------------------
# Leave these blank and the service still runs: uploads return 503 and everything
# else works. Fill them in from your Cloudinary dashboard to try uploads locally.
#
# The API secret signs upload requests. It never leaves the server and never
# appears in a response - only the derived signature does.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Keycloak (only needed once auth is switched on outside dev) ---
OIDC_AUTH_SERVER_URL=http://localhost:8180/realms/houseagent
OIDC_CLIENT_ID=houseagent-backend
OIDC_CLIENT_SECRET=change-me
